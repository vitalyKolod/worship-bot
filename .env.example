BOT_TOKEN=123456789:replace_with_botfather_token
MONGODB_URI=mongodb://127.0.0.1:27017/worship-bot
SUPER_ADMIN_IDS=123456789
APP_TIMEZONE=Europe/Moscow
REMINDER_INTERVAL_MS=60000
REMINDER_TEST_MODE=false

AUDIO_PROCESSING_ENABLED=false
# Optional: enables AI suggestions for the first downbeat and song sections.
ROUTERAI_API_KEY=
ROUTERAI_AUDIO_MODEL=openai/gpt-audio
AUDIO_STORAGE_PATH=data/songs
AUDIO_MAX_CONCURRENT_JOBS=1
AUDIO_MAX_UPLOAD_BYTES=20971520
AUDIO_FFMPEG_PATH=ffmpeg
AUDIO_FFPROBE_PATH=ffprobe
# Directory containing "Click Tracks" and "English Guides"; leave empty for synthesized click only.
AUDIO_GUIDES_PATH=
AUDIO_SEPARATOR_PYTHON=.audio-venv/bin/python
AUDIO_SEPARATOR_MODEL=htdemucs_6s
AUDIO_PROCESS_TIMEOUT_MS=1800000
AUDIO_WORKER_POLL_MS=5000
